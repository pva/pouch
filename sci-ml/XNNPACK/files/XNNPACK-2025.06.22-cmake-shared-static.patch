Build shared and static XNNPACK libraries together.

Keep the XNNPACK target static in the new "both" mode, as upstream unit
tests need internal symbols hidden from the shared library. Apply the
same dependencies and build settings to both targets and install both.

--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -38,8 +38,8 @@
 SET(CMAKE_CXX_STANDARD_REQUIRED YES)
 SET(CMAKE_CXX_EXTENSIONS NO)
 # ---[ Options.
-SET(XNNPACK_LIBRARY_TYPE "default" CACHE STRING "Type of library (shared, static, or default) to build")
-SET_PROPERTY(CACHE XNNPACK_LIBRARY_TYPE PROPERTY STRINGS default static shared)
+SET(XNNPACK_LIBRARY_TYPE "default" CACHE STRING "Type of library (shared, static, both, or default) to build")
+SET_PROPERTY(CACHE XNNPACK_LIBRARY_TYPE PROPERTY STRINGS default static shared both)
 IF(CMAKE_C_COMPILER_ID STREQUAL "MSVC")
   # Disable assembly when using MSVC until support is added.
   OPTION(XNNPACK_ENABLE_ASSEMBLY "Build XNNPACK with assembly micro-kernels" OFF)
@@ -842,14 +842,22 @@
   ADD_LIBRARY(xnnpack-subgraph OBJECT ${SUBGRAPH_SRCS})
   # Need C_EXTENSIONS to get constants for mmap (MAP_ANONYMOUS).
   SET_TARGET_PROPERTIES(xnnpack-memory PROPERTIES C_EXTENSIONS YES)
+  SET(XNNPACK_LIBRARY_TARGETS XNNPACK)
   IF(XNNPACK_LIBRARY_TYPE STREQUAL "default")
     ADD_LIBRARY(XNNPACK ${XNNPACK_SRCS})
   ELSEIF(XNNPACK_LIBRARY_TYPE STREQUAL "shared")
     ADD_LIBRARY(XNNPACK SHARED ${XNNPACK_SRCS})
   ELSEIF(XNNPACK_LIBRARY_TYPE STREQUAL "static")
     ADD_LIBRARY(XNNPACK STATIC ${XNNPACK_SRCS})
+  ELSEIF(XNNPACK_LIBRARY_TYPE STREQUAL "both")
+    # Tests need internal symbols that are not exported by the shared library.
+    # Keep XNNPACK static so existing test targets link against that version.
+    ADD_LIBRARY(XNNPACK STATIC ${XNNPACK_SRCS})
+    ADD_LIBRARY(XNNPACK_shared SHARED ${XNNPACK_SRCS})
+    SET_TARGET_PROPERTIES(XNNPACK_shared PROPERTIES OUTPUT_NAME XNNPACK)
+    LIST(APPEND XNNPACK_LIBRARY_TARGETS XNNPACK_shared)
   ELSE()
-    MESSAGE(FATAL_ERROR "Unsupported XNNPACK library type \"${XNNPACK_LIBRARY_TYPE}\". Must be \"static\", \"shared\", or \"default\"")
+    MESSAGE(FATAL_ERROR "Unsupported XNNPACK library type \"${XNNPACK_LIBRARY_TYPE}\". Must be \"static\", \"shared\", \"both\", or \"default\"")
   ENDIF()
   TARGET_LINK_LIBRARIES(xnnpack-allocator PRIVATE xnnpack-base xnnpack-logging)
   TARGET_LINK_LIBRARIES(xnnpack-cache PRIVATE xnnpack-base xnnpack-logging)
@@ -864,12 +872,14 @@
   TARGET_LINK_LIBRARIES(xnnpack-operator-utils PRIVATE xnnpack-base xnnpack-logging)
   TARGET_LINK_LIBRARIES(xnnpack-reference-ukernels PRIVATE xnnpack-base xnnpack-datatype)
   TARGET_LINK_LIBRARIES(xnnpack-subgraph PRIVATE xnnpack-base xnnpack-allocator xnnpack-logging xnnpack-memory xnnpack-mutex xnnpack-operators xnnpack-operator-run xnnpack-datatype)
-  TARGET_LINK_LIBRARIES(XNNPACK PRIVATE xnnpack-base xnnpack-allocator xnnpack-cache
-      xnnpack-hardware-config xnnpack-indirection xnnpack-memory xnnpack-microkernel-utils xnnpack-microparams-init
-      xnnpack-mutex xnnpack-normalization xnnpack-operators xnnpack-operator-run xnnpack-operator-utils xnnpack-pack-lh xnnpack-packing
-      xnnpack-microkernels-prod xnnpack-subgraph xnnpack-datatype xnnpack-reference-ukernels)
-  TARGET_LINK_LIBRARIES(XNNPACK PUBLIC pthreadpool xnnpack-logging)
-  SET_TARGET_PROPERTIES(XNNPACK PROPERTIES C_EXTENSIONS YES)
+  FOREACH(XNNPACK_LIBRARY_TARGET IN LISTS XNNPACK_LIBRARY_TARGETS)
+    TARGET_LINK_LIBRARIES(${XNNPACK_LIBRARY_TARGET} PRIVATE xnnpack-base xnnpack-allocator xnnpack-cache
+        xnnpack-hardware-config xnnpack-indirection xnnpack-memory xnnpack-microkernel-utils xnnpack-microparams-init
+        xnnpack-mutex xnnpack-normalization xnnpack-operators xnnpack-operator-run xnnpack-operator-utils xnnpack-pack-lh xnnpack-packing
+        xnnpack-microkernels-prod xnnpack-subgraph xnnpack-datatype xnnpack-reference-ukernels)
+    TARGET_LINK_LIBRARIES(${XNNPACK_LIBRARY_TARGET} PUBLIC pthreadpool xnnpack-logging)
+    SET_TARGET_PROPERTIES(${XNNPACK_LIBRARY_TARGET} PROPERTIES C_EXTENSIONS YES)
+  ENDFOREACH()
 ENDIF()
 IF(NOT MSVC)
   SET_PROPERTY(SOURCE ${ALL_MICROKERNEL_SRCS} APPEND_STRING PROPERTY COMPILE_FLAGS " -fno-math-errno ")
@@ -1060,7 +1070,9 @@
     TARGET_COMPILE_OPTIONS(xnnpack-mutex PRIVATE "$<$<NOT:$<CONFIG:Debug>>:/O1>")
     TARGET_COMPILE_OPTIONS(xnnpack-subgraph PRIVATE "$<$<NOT:$<CONFIG:Debug>>:/O1>")
     TARGET_COMPILE_OPTIONS(xnnpack-operators PRIVATE "$<$<NOT:$<CONFIG:Debug>>:/O1>")
-    TARGET_COMPILE_OPTIONS(XNNPACK PRIVATE "$<$<NOT:$<CONFIG:Debug>>:/O1>")
+    FOREACH(XNNPACK_LIBRARY_TARGET IN LISTS XNNPACK_LIBRARY_TARGETS)
+      TARGET_COMPILE_OPTIONS(${XNNPACK_LIBRARY_TARGET} PRIVATE "$<$<NOT:$<CONFIG:Debug>>:/O1>")
+    ENDFOREACH()
   ENDIF()
 ELSE()
   TARGET_COMPILE_OPTIONS(xnnpack-base INTERFACE "$<$<NOT:$<CONFIG:Debug>>:-O2>")
@@ -1082,19 +1094,25 @@
     TARGET_COMPILE_OPTIONS(xnnpack-mutex PRIVATE "$<$<NOT:$<CONFIG:Debug>>:-Os>")
     TARGET_COMPILE_OPTIONS(xnnpack-subgraph PRIVATE "$<$<NOT:$<CONFIG:Debug>>:-Os>")
     TARGET_COMPILE_OPTIONS(xnnpack-operators PRIVATE "$<$<NOT:$<CONFIG:Debug>>:-Os>")
-    TARGET_COMPILE_OPTIONS(XNNPACK PRIVATE "$<$<NOT:$<CONFIG:Debug>>:-Os>")
+    FOREACH(XNNPACK_LIBRARY_TARGET IN LISTS XNNPACK_LIBRARY_TARGETS)
+      TARGET_COMPILE_OPTIONS(${XNNPACK_LIBRARY_TARGET} PRIVATE "$<$<NOT:$<CONFIG:Debug>>:-Os>")
+    ENDFOREACH()
   ENDIF()
 ENDIF()
 INCLUDE_DIRECTORIES(.)
 TARGET_INCLUDE_DIRECTORIES(xnnpack-hardware-config PRIVATE include src ${CPUINFO_SOURCE_DIR}/include)
 IF(XNNPACK_BUILD_LIBRARY)
-  TARGET_INCLUDE_DIRECTORIES(XNNPACK PUBLIC include)
+  FOREACH(XNNPACK_LIBRARY_TARGET IN LISTS XNNPACK_LIBRARY_TARGETS)
+    TARGET_INCLUDE_DIRECTORIES(${XNNPACK_LIBRARY_TARGET} PUBLIC include)
+    SET_PROPERTY(TARGET ${XNNPACK_LIBRARY_TARGET} PROPERTY PUBLIC_HEADER include/xnnpack.h)
+    IF(WIN32)
+      # Target Windows 7+ API
+      TARGET_COMPILE_DEFINITIONS(${XNNPACK_LIBRARY_TARGET} PRIVATE _WIN32_WINNT=0x0601)
+    ENDIF()
+  ENDFOREACH()
   IF(WIN32)
-    # Target Windows 7+ API
-    TARGET_COMPILE_DEFINITIONS(XNNPACK PRIVATE _WIN32_WINNT=0x0601)
     TARGET_COMPILE_DEFINITIONS(xnnpack-mutex PRIVATE _WIN32_WINNT=0x0601)
   ENDIF()
-  SET_PROPERTY(TARGET XNNPACK PROPERTY PUBLIC_HEADER include/xnnpack.h)
 ENDIF()
 # ---[ Find libm
 IF(XNNPACK_BUILD_WITH_LIBM)
@@ -1108,7 +1126,9 @@
     TARGET_LINK_LIBRARIES(xnnpack-indirection PRIVATE ${LIBM})
     TARGET_LINK_LIBRARIES(xnnpack-subgraph PRIVATE ${LIBM})
     IF(XNNPACK_BUILD_LIBRARY)
-      TARGET_LINK_LIBRARIES(XNNPACK PRIVATE ${LIBM})
+      FOREACH(XNNPACK_LIBRARY_TARGET IN LISTS XNNPACK_LIBRARY_TARGETS)
+        TARGET_LINK_LIBRARIES(${XNNPACK_LIBRARY_TARGET} PRIVATE ${LIBM})
+      ENDFOREACH()
     ENDIF()
   ENDIF()
 ENDIF()
@@ -1135,7 +1155,9 @@
 ENDIF()
 IF(XNNPACK_BUILD_LIBRARY)
   TARGET_LINK_LIBRARIES(xnnpack-hardware-config PRIVATE cpuinfo)
-  TARGET_LINK_LIBRARIES(XNNPACK PRIVATE cpuinfo)
+  FOREACH(XNNPACK_LIBRARY_TARGET IN LISTS XNNPACK_LIBRARY_TARGETS)
+    TARGET_LINK_LIBRARIES(${XNNPACK_LIBRARY_TARGET} PRIVATE cpuinfo)
+  ENDFOREACH()
 ENDIF()
 # ---[ Configure pthreadpool
 IF(NOT TARGET pthreadpool)
@@ -1184,10 +1206,12 @@
 TARGET_LINK_LIBRARIES(xnnpack-microkernels-prod PRIVATE fxdiv)
 TARGET_LINK_LIBRARIES(xnnpack-indirection PRIVATE fxdiv)
 IF(XNNPACK_BUILD_LIBRARY)
-  TARGET_LINK_LIBRARIES(XNNPACK PRIVATE fxdiv)
+  FOREACH(XNNPACK_LIBRARY_TARGET IN LISTS XNNPACK_LIBRARY_TARGETS)
+    TARGET_LINK_LIBRARIES(${XNNPACK_LIBRARY_TARGET} PRIVATE fxdiv)
+  ENDFOREACH()
 ENDIF()
 IF(XNNPACK_BUILD_LIBRARY)
-  INSTALL(TARGETS XNNPACK xnnpack-microkernels-prod
+  INSTALL(TARGETS ${XNNPACK_LIBRARY_TARGETS} xnnpack-microkernels-prod
       LIBRARY DESTINATION ${CMAKE_INSTALL_LIBDIR}
