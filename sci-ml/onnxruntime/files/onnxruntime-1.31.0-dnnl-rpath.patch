Let CMake manage the oneDNN provider's origin-relative runtime path.

Introduced by:
https://github.com/microsoft/onnxruntime/commit/fc6ac5bfacc4a7fafc6bc5625c08b3d4e188af92

The raw -rpath=$ORIGIN linker flag is expanded by the shell. When ORIGIN
is unset, this leaves an empty runtime search path. Use CMake's RPATH
properties so it handles escaping and installation, while retaining
lookup of the adjacent libonnxruntime_providers_shared.so.

Explicitly include $ORIGIN in BUILD_RPATH so the provider can also find
libdnnl.so.3 and libonnxruntime_providers_shared.so when the Python build
copies these libraries into onnxruntime/capi without cmake --install.
BUILD_RPATH_USE_ORIGIN only rewrites automatically generated build paths;
it does not guarantee a separate $ORIGIN entry for the copied libraries.

https://github.com/microsoft/onnxruntime/pull/33582

--- a/cmake/onnxruntime_providers_dnnl.cmake
+++ b/cmake/onnxruntime_providers_dnnl.cmake
@@ -42,7 +42,11 @@
       BUILD_WITH_INSTALL_RPATH TRUE
       INSTALL_RPATH_USE_LINK_PATH FALSE)
   elseif(UNIX)
-    set_property(TARGET onnxruntime_providers_dnnl APPEND_STRING PROPERTY LINK_FLAGS "-Xlinker --version-script=${ONNXRUNTIME_ROOT}/core/providers/dnnl/version_script.lds -Xlinker --gc-sections -Xlinker -rpath=\$ORIGIN")
+    set_property(TARGET onnxruntime_providers_dnnl APPEND_STRING PROPERTY LINK_FLAGS "-Xlinker --version-script=${ONNXRUNTIME_ROOT}/core/providers/dnnl/version_script.lds -Xlinker --gc-sections")
+    set_target_properties(onnxruntime_providers_dnnl PROPERTIES
+      BUILD_RPATH "$ORIGIN"
+      BUILD_RPATH_USE_ORIGIN TRUE
+      INSTALL_RPATH "$ORIGIN")
   elseif(WIN32)
     set_property(TARGET onnxruntime_providers_dnnl APPEND_STRING PROPERTY LINK_FLAGS "-DEF:${ONNXRUNTIME_ROOT}/core/providers/dnnl/symbols.def")
   else()
