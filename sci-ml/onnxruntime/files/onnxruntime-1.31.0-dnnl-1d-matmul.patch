+++ b/onnxruntime/core/providers/dnnl/subgraph/dnnl_matmul.cc
@@ -83,6 +83,13 @@
   auto src_dims = sp.GetMemory(node.Input(IN_A)).get_desc().get_dims();
   auto weights_dims = sp.GetMemory(node.Input(IN_B)).get_desc().get_dims();
 
+  // The capability check rejects inputs of rank < 2 only when their shapes are known.
+  // The code below assumes matrices and overruns output_shape for 1D inputs.
+  if (src_dims.size() < 2 || weights_dims.size() < 2) {
+    ORT_THROW(node.OpType(), ": oneDNN requires inputs of rank >= 2, got ",
+              src_dims.size(), " and ", weights_dims.size());
