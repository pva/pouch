Add opt-in support for installed oneDNN and shared XNNPACK libraries.

Both options default to OFF. Keep the existing ExternalProject/FetchContent
paths, platform workarounds and bundled-library configuration unchanged.

With onnxruntime_USE_SYSTEM_DNNL, use the oneDNN imported target under the
existing dnnl name, and omit only the project_dnnl build dependency. Keep
OpenMP flags on the provider, which uses OpenMP directly. Resolve the DLL
path from the imported target for the existing test/Python copy commands.

With onnxruntime_USE_SYSTEM_XNNPACK, use imported XNNPACK and pthreadpool
targets. The installed shared XNNPACK includes its production microkernels
and manages its private dependencies, so no separate microkernel archive
or source downloads are needed.

--- a/cmake/CMakeLists.txt
+++ b/cmake/CMakeLists.txt
@@ -83,6 +83,7 @@
 option(onnxruntime_USE_SNPE "Build with SNPE support" OFF)
 option(onnxruntime_USE_RKNPU "Build with RKNPU support" OFF)
 option(onnxruntime_USE_DNNL "Build with DNNL support" OFF)
+option(onnxruntime_USE_SYSTEM_DNNL "Use an installed oneDNN library" OFF)
 option(onnxruntime_USE_JSEP "Build with JavaScript implemented kernels support" OFF)
 option(onnxruntime_USE_SVE "Build with SVE support in MLAS" OFF)
 option(onnxruntime_USE_RVV "Build with RISC-V Vector support in MLAS" OFF)
@@ -213,6 +214,7 @@
 cmake_dependent_option(onnxruntime_USE_MIMALLOC "Override new/delete and arena allocator with mimalloc" OFF "WIN32;NOT onnxruntime_USE_CUDA;NOT onnxruntime_USE_OPENVINO" OFF)
 option(onnxruntime_USE_CANN "Build with CANN support" OFF)
 option(onnxruntime_USE_XNNPACK "Build with XNNPACK support. Provides an alternative math library on ARM, WebAssembly and x86." OFF)
+option(onnxruntime_USE_SYSTEM_XNNPACK "Use installed shared XNNPACK and pthreadpool libraries" OFF)
 option(onnxruntime_USE_WEBNN "Build with WebNN support. Enable hardware acceleration in web browsers." OFF)
 option(onnxruntime_USE_WEBGPU "Build with WebGPU support. Enable WebGPU via C/C++ interface." OFF)
 option(onnxruntime_USE_EP_API_ADAPTERS "Build EP (e.g. WebGPU) as a plugin EP library using EP API adapters" OFF)
--- a/cmake/external/dnnl.cmake
+++ b/cmake/external/dnnl.cmake
@@ -1,3 +1,11 @@
+if(onnxruntime_USE_SYSTEM_DNNL)
+  find_package(dnnl 3.0.1 CONFIG REQUIRED)
+  find_package(OpenMP REQUIRED COMPONENTS CXX)
+  add_library(dnnl ALIAS DNNL::dnnl)
+  set(DNNL_DLL_PATH "$<TARGET_FILE:DNNL::dnnl>")
+  return()
+endif()
+
 include (ExternalProject)

 set(DNNL_URL https://github.com/oneapi-src/onednn.git)
--- a/cmake/external/xnnpack.cmake
+++ b/cmake/external/xnnpack.cmake
@@ -1,3 +1,26 @@
+if(onnxruntime_USE_SYSTEM_XNNPACK)
+  find_path(XNNPACK_INCLUDE_DIR NAMES xnnpack.h REQUIRED)
+  find_library(XNNPACK_LIBRARY NAMES XNNPACK REQUIRED)
+  find_path(PTHREADPOOL_INCLUDE_DIR NAMES pthreadpool.h REQUIRED)
+  find_library(PTHREADPOOL_LIBRARY NAMES pthreadpool REQUIRED)
+  find_package(Threads REQUIRED)
+
+  add_library(pthreadpool UNKNOWN IMPORTED)
+  set_target_properties(pthreadpool PROPERTIES
+    IMPORTED_LOCATION "${PTHREADPOOL_LIBRARY}"
+    INTERFACE_INCLUDE_DIRECTORIES "${PTHREADPOOL_INCLUDE_DIR}"
+    INTERFACE_LINK_LIBRARIES Threads::Threads
+  )
+  add_library(XNNPACK UNKNOWN IMPORTED)
+  set_target_properties(XNNPACK PROPERTIES
+    IMPORTED_LOCATION "${XNNPACK_LIBRARY}"
+    INTERFACE_INCLUDE_DIRECTORIES "${XNNPACK_INCLUDE_DIR}"
+    INTERFACE_LINK_LIBRARIES pthreadpool
+  )
+  set(onnxruntime_EXTERNAL_LIBRARIES_XNNPACK XNNPACK pthreadpool)
+  return()
+endif()
+
 set(XNNPACK_USE_SYSTEM_LIBS ON CACHE INTERNAL "")
 set(XNNPACK_BUILD_TESTS OFF CACHE INTERNAL "")
 set(XNNPACK_BUILD_BENCHMARKS OFF CACHE INTERNAL "")
--- a/cmake/onnxruntime_providers_dnnl.cmake
+++ b/cmake/onnxruntime_providers_dnnl.cmake
@@ -16,7 +16,12 @@
     target_compile_options(onnxruntime_providers_dnnl PRIVATE  "/analyze:stacksize 131072")
   endif()

-  add_dependencies(onnxruntime_providers_dnnl onnxruntime_providers_shared project_dnnl ${onnxruntime_EXTERNAL_DEPENDENCIES})
+  add_dependencies(onnxruntime_providers_dnnl onnxruntime_providers_shared ${onnxruntime_EXTERNAL_DEPENDENCIES})
+  if(onnxruntime_USE_SYSTEM_DNNL)
+    target_link_libraries(onnxruntime_providers_dnnl PRIVATE OpenMP::OpenMP_CXX)
+  else()
+    add_dependencies(onnxruntime_providers_dnnl project_dnnl)
+  endif()
   target_include_directories(onnxruntime_providers_dnnl PRIVATE ${ONNXRUNTIME_ROOT} ${DNNL_INCLUDE_DIR} ${DNNL_OCL_INCLUDE_DIR})
   # ${CMAKE_CURRENT_BINARY_DIR} is so that #include "onnxruntime_config.h" inside tensor_shape.h is found
   target_link_libraries(onnxruntime_providers_dnnl PRIVATE dnnl ${ONNXRUNTIME_PROVIDERS_SHARED} Boost::mp11 ${ABSEIL_LIBS} ${GSL_TARGET} safeint_interface Eigen3::Eigen)
