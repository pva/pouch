Validate the axis attribute in LayerNormalization shape inference.

Upstream: https://github.com/onnx/onnx/commit/7e45ad5c7093ed498a5a09c1ef5537bb37da279c

A positive axis >= rank was accepted and then narrowed to int, so an axis
such as 0xFFFFFFFF became -1 and was used as an out-of-bounds index into
the Mean and InvStdDev output shapes. Reject it with a shape inference
error instead. ONNX Runtime patches its bundled ONNX the same way, and its
LayerNormTest.LayerNorm_AxisExceedsRank crashes with the system ONNX otherwise.

--- a/onnx/defs/nn/defs.cc
+++ b/onnx/defs/nn/defs.cc
@@ -2692,7 +2692,7 @@
             // positive value.
             axis += input_ndim;
           }
-          if (axis < 0) {
+          if (axis < 0 || axis >= input_ndim) {
             fail_shape_inference(
                 "Unexpected axis value (",
                 axis,
@@ -2705,14 +2705,14 @@
           if (ctx.getNumOutputs() > 1) {
             auto mean_shape = ctx.getOutputType(1)->mutable_tensor_type()->mutable_shape();
             mean_shape->CopyFrom(input_shape);
-            for (int d = static_cast<int>(axis); d < input_ndim; ++d)
+            for (auto d = axis; d < input_ndim; ++d)
               mean_shape->mutable_dim(d)->set_dim_value(1);
           }
 
           if (ctx.getNumOutputs() > 2) {
             auto inv_std_dev_shape = ctx.getOutputType(2)->mutable_tensor_type()->mutable_shape();
             inv_std_dev_shape->CopyFrom(input_shape);
-            for (int d = static_cast<int>(axis); d < input_ndim; ++d)
+            for (auto d = axis; d < input_ndim; ++d)
               inv_std_dev_shape->mutable_dim(d)->set_dim_value(1);
           }
         }));
